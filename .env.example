# Web client configuration
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-public-anon-key"

# Optional: analytics or feature flags
# VITE_SOME_FLAG="true"

# Supabase / Edge function secrets
# These values are typically set via `supabase secrets set`.
# They are included here to document what needs to be available when developing locally.
MOBILENIG_PUBLIC_KEY="your-mobilenig-public-key"
MOBILENIG_SECRET_KEY="your-mobilenig-secret-key"
SMEPLUG_PUBLIC_KEY="your-smeplug-public-key"
SMEPLUG_SECRET_KEY="your-smeplug-secret-key"
PAYVESSEL_API_KEY="your-payvessel-api-key"
PAYVESSEL_SECRET_KEY="your-payvessel-secret-key"
PAYVESSEL_BUSINESS_ID="your-payvessel-business-id"
