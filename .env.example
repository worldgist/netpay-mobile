# Web client configuration
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-public-anon-key"
VITE_SITE_URL="https://netppay.com"

# Customer web app = Expo (login, signup, wallet, pay bills). Admin = Vite (/auth, /dashboard).
# Local default when unset in DEV: http://localhost:8081
# VITE_EXPO_WEB_URL="http://localhost:8081"

# New primary database connection (used by local migration scripts)
DATABASE_URL="postgresql://username:password@host:5432/database"
POSTGRES_URL="postgresql://username:password@host:5432/database"

# Optional: analytics or feature flags
# VITE_SOME_FLAG="true"

# Web: optional extra hosts where marketing-only rules apply (admin /auth still works)
# VITE_BLOCK_WEB_APP_ON_HOSTS="netppay.com,www.netppay.com"

# Mobile (Expo)
# EXPO_PUBLIC_SITE_URL="https://netppay.com"

# Supabase Auth (Dashboard → Authentication → URL Configuration) — set manually:
# Site URL: https://netppay.com
# Redirect URLs: https://netppay.com/**, https://www.netppay.com/**, netpay://**

# Supabase Edge Function secrets (set via: npm run supabase:sync-secrets)
# NETPAY_SITE_URL=https://netppay.com
# SITE_URL=https://netppay.com
# NETPAY_LOGO_URL=https://netppay.com/logo.png
# BLOCK_VPN_PROXY=true

# Provider credentials — primary location: Supabase Dashboard → Edge Functions → Secrets
# Optional local copies only if you run: npm run supabase:sync-secrets
# MOBILENIG_PUBLIC_KEY=  # validation, packages, balance (Supabase secrets only)
# MOBILENIG_SECRET_KEY=  # purchases and transaction queries (Supabase secrets only)
# PAYVESSEL_API_KEY=
# PAYVESSEL_SECRET_KEY=
PAYVESSEL_BUSINESS_ID="5EE89DA992424C6DA0234577E7E4ECAA"
VTPASS_MODE=live
# SMEPLUG_SECRET_KEY=
# EBILLS_USERNAME=
# EBILLS_PASSWORD=
# VTPASS_API_KEY=
# VTPASS_PUBLIC_KEY=
# VTPASS_SECRET_KEY=
# FLUTTERWAVE_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_SECRET_HASH=
# Resend (transactional email) — API key lives in Supabase Edge Function secrets only.
# Sync from local .env with: npm run supabase:sync-secrets
# Do NOT put RESEND_API_KEY in VITE_* or EXPO_PUBLIC_* client env vars.
# RESEND_API_KEY=
RESEND_FROM_EMAIL="NetPay Notifications <support@netppay.com>"
RESEND_TO_EMAIL="support@netppay.com"
# OPENAI_API_KEY=
