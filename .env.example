# Web client configuration
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-public-anon-key"
VITE_SITE_URL="https://netpayy.ng"

# Optional: analytics or feature flags
# VITE_SOME_FLAG="true"

# Web: block wallet/admin routes on these hosts (default: netpayy.ng, www.netpayy.ng)
# VITE_BLOCK_WEB_APP_ON_HOSTS="netpayy.ng,www.netpayy.ng"

# Mobile (Expo)
# EXPO_PUBLIC_SITE_URL="https://netpayy.ng"

# Supabase Auth (Dashboard → Authentication → URL Configuration) — set manually:
# Site URL: https://netpayy.ng
# Redirect URLs: https://netpayy.ng/**, https://www.netpayy.ng/**, netpay://**

# Supabase Edge Function secrets (set via: supabase secrets set ...)
# NETPAY_SITE_URL=https://netpayy.ng
# SITE_URL=https://netpayy.ng
# NETPAY_LOGO_URL=https://netpayy.ng/logo.png
# BLOCK_VPN_PROXY=true
# PROXYCHECK_API_KEY=optional-for-higher-vpn-detection-limits

# Supabase / Edge function secrets
# NETPAY_SITE_URL="https://netpayy.ng"
# These values are typically set via `supabase secrets set`.
# They are included here to document what needs to be available when developing locally.
MOBILENIG_PUBLIC_KEY="your-mobilenig-public-key"
MOBILENIG_SECRET_KEY="your-mobilenig-secret-key"
SMEPLUG_PUBLIC_KEY="your-smeplug-public-key"
SMEPLUG_SECRET_KEY="your-smeplug-secret-key"
PAYVESSEL_API_KEY="your-payvessel-api-key"
PAYVESSEL_SECRET_KEY="your-payvessel-secret-key"
PAYVESSEL_BUSINESS_ID="your-payvessel-business-id"
