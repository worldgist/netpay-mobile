{
  "name": "netpay",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --clear --lan --go",
    "export:web": "expo export -p web && node ./scripts/fix-expo-web-fonts.js && node ./scripts/write-seo-files.js",
    "deploy:web": "npm run export:web && node -e \"require('fs').writeFileSync('dist/vercel.json', JSON.stringify({framework:null,headers:[{source:'/sw.js',headers:[{key:'Cache-Control',value:'no-cache, no-store, must-revalidate'},{key:'Service-Worker-Allowed',value:'/'}]},{source:'/manifest.webmanifest',headers:[{key:'Content-Type',value:'application/manifest+json'}]}],rewrites:[{source:'/((?!_expo/|assets/|robots\\\\.txt|sitemap\\\\.xml|og-image\\\\.png|logo\\\\.png|favicon\\\\.ico|manifest\\\\.webmanifest|sw\\\\.js|pwa-192\\\\.png|pwa-512\\\\.png|apple-touch-icon\\\\.png|buy/(?:airtime|data|electricity|cable-tv|education|betting|wallet|transfer)|search).*)',destination:'/'}]},null,2)+'\\n')\" && npx vercel deploy dist --prod --yes --scope netpayuser-2571s-projects --project netpay-expo",
    "start:dev": "expo start --clear --lan --dev-client",
    "start:usb": "powershell -ExecutionPolicy Bypass -File ./scripts/connect-android-usb.ps1",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "validate": "node ./scripts/validate-config.js",
    "postinstall": "node ./scripts/patch-bottom-tabs-navigate.js",
    "doctor": "node ./scripts/validate-config.js && npx expo-doctor || echo 'Note: expo-doctor network check failed, but local validation passed'",
    "generate:icons": "node ./scripts/generate-square-icons.js",
    "generate:notification-icon": "node ./scripts/generate-notification-icon.js",
    "setup:android-push": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-android-push.ps1",
    "upload:fcm-eas": "powershell -ExecutionPolicy Bypass -File ./scripts/upload-fcm-to-eas.ps1",
    "sync:eas-env": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-eas-env.ps1",
    "build:android:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:aab": "npx eas-cli@latest build --platform android --profile production",
    "prebuild:android": "expo prebuild --platform android && node ./scripts/patch-android-gradle-network.js",
    "prebuild:android:clean": "expo prebuild --platform android --clean && node ./scripts/patch-android-gradle-network.js",
    "android:assemble:release": "expo run:android --variant release"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.80.0",
    "@vercel/analytics": "^2.0.1",
    "expo": "~57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "sharp": "^0.34.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
