EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SITE_URL=https://netppay.com

# Production Expo web (Vercel project: Root Directory = mobile, domain app.netppay.com)
# Set the same EXPO_PUBLIC_* values in that Vercel project.
# Then set VITE_EXPO_WEB_URL=https://app.netppay.com on the Vite (netppay.com) project.
# Supabase Auth redirect URLs: add https://app.netppay.com/**

# Email is sent via Supabase Edge Functions (send-support-email, statement-of-account).
# RESEND_API_KEY is stored in Supabase secrets — never add it here.

# New primary database connection (used by local migration scripts)
DATABASE_URL=postgresql://username:password@host:5432/database
